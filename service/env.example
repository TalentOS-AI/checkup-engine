# Copy to /etc/checkup-engine/env (chmod 600). Never commit real values.
CHECKUP_SERVICE_TOKEN=replace-with-long-random
CHECKUP_JOB_HMAC=replace-with-another-long-random
CHECKUP_BIND=127.0.0.1
CHECKUP_PORT=8790
CHECKUP_DATA_DIR=/var/lib/checkup-engine
CHECKUP_DAILY_BUDGET_USD=1.0
CHECKUP_CACHE_TTL_S=86400
CHECKUP_WORKERS=2
CHECKUP_DEADLINE_S=75

# LLM gateway (same values as /workspace/secrets/checkup-demo.env on the box)
GATEWAY_CHECKUP_KEY=replace
GATEWAY_CHECKUP_MODEL=deepseek-v4
GATEWAY_CHECKUP_BASE_URL=https://llm.agentbay.asia/v1
# On the VM itself you can point at the local LiteLLM instead:
# GATEWAY_CHECKUP_BASE_URL=http://127.0.0.1:<litellm-port>/v1
